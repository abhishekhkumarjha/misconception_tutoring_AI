# Required: API key for Gemini models
GEMINI_API_KEY="your-gemini-api-key"

# Optional: Gemini model for the math tutor (default gemini-2.5-flash, which new API keys cannot use)
# GEMINI_MODEL="gemini-3.5-flash"
# Optional: reasoning effort for gemini-3* models (default HIGH; LOW is faster). Ignored for gemini-2.5 models.
# GEMINI_THINKING_LEVEL="HIGH"
# Optional: second model tried once when the main model is overloaded (503). Set to "" to disable.
# GEMINI_FALLBACK_MODEL="gemini-3.1-flash-lite"
# Optional: Python interpreter used for the Python tutor (default: python on Windows, python3 elsewhere)
# PYTHON_BIN="python3"
# Optional: address of the FastAPI Python service (python -m python_service.api)
# PYTHON_SERVICE_URL="http://127.0.0.1:8000"
# Optional: interface the web server listens on (default 127.0.0.1; 0.0.0.0 exposes it to your network)
# HOST="127.0.0.1"

# Optional: Host URL for self-referential links or deployment
APP_URL="http://localhost:3000"
